{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenroApp",
  "version": "0.1.0",
  "identifier": "it.softwell.genropy.runner",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "softwell", "rundoc"
        ],
        "name": "Collegamento SoftWell",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.softwell.connection+json",
        "exportedType": {
          "identifier": "it.softwell.runner.connection",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "resources": {
      "icons/softwell-link.icns": "softwell-link.icns"
    }
  }
}
