{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenroApp",
  "version": "0.2.0",
  "identifier": "it.softwell.genropy.runner",
  "build": {
    "frontendDist": "../setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "softwell",
          "rundoc"
        ],
        "name": "Collegamento SoftWell",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.softwell.connection+json",
        "exportedType": {
          "identifier": "it.softwell.runner.connection",
          "conformsTo": [
            "public.json"
          ]
        }
      }
    ],
    "resources": {
      "icons/softwell-link.icns": "softwell-link.icns"
    },
    "macOS": {
      "entitlements": "GenroApp.entitlements"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQThGNUMwQkZGOTA3MkEKUldRcUIvbS93UFdvc2QvN1d2akR2OUVMZmZUQ1o1T25BeFRBQVZkZjlRTC9aNVgxR0N1by9JMU4K",
      "endpoints": [
        "https://genroapp-downloads.fsn1.your-objectstorage.com/latest.json"
      ]
    }
  }
}
