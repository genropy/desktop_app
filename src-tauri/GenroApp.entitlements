<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime refuses camera and microphone without these, and macOS shows no prompt.
	     The Meetlot windows (team meetings, support) use them. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The PKCS#11 libraries of the signature cards (bit4id, Athena, OpenSC) are signed by their vendors: the
	     hardened runtime refuses to load them without this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- The device keys of the sites live in the data protection keychain, in this group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>HXS58UUB2N.it.softwell.genropy.runner</string>
	</array>
</dict>
</plist>
